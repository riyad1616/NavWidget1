<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_nav"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floating Navigation Widget"
            android:textSize="14sp"
            android:alpha="0.7"
            android:layout_marginBottom="32dp" />

        <!-- Permissions Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_gravity="start" />

        <Button
            android:id="@+id/btnNotifStatus"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notif_status"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOverlayStatus"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_status"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOpenNotifications"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_notifications"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOpenOverlay"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_overlay"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOpenUsageStats"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_usage_stats"
            android:layout_marginBottom="32dp" />

        <!-- Widget Controls -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Widget Controls"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_gravity="start" />

        <Button
            android:id="@+id/btnStartWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_widget"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStopWidget"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop_widget"
            android:layout_marginBottom="24dp" />

        <!-- Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_gravity="start" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swShowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_card"
            android:layout_marginBottom="8dp"
            android:checked="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swHideOnMaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_on_maps"
            android:layout_marginBottom="8dp"
            android:checked="true" />

    </LinearLayout>
</ScrollView>
